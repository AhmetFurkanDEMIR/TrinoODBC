; NSIS 3 script for the Trino ODBC driver: Windows x64 installer, buildable on macOS and Linux.
;
; Build (recommended; validates the stage tree, derives the version and runs makensis):
;   packaging/windows/build_installer.sh [--stage DIR] [--out DIR] [--version V]
; Direct build:
;   makensis -DVERSION=1.0.0 -DSTAGE=/abs/stage -DOUT=/abs/out packaging/windows/installer.nsi
;   makensis.exe /DVERSION=1.0.0 /DSTAGE=C:\stage /DOUT=C:\out packaging\windows\installer.nsi
; (makensis on macOS needs a UTF-8 locale, e.g. LC_ALL=C.UTF-8; the "C" locale makes it crash.)
;
; Compile-time defines:
;   VERSION          (required) product version, e.g. 1.0.0 or 1.2.0-rc1
;   STAGE            (required) absolute path of the staging tree:
;                      x64/trinoodbc.dll   the driver (plus dependency DLLs, see EXTRA_DLLS_NSH)
;                      docs/*.md           documentation
;                      powerbi/TrinoODBC.mez, powerbi/README.md   Power BI custom connector
;   OUT              (required) existing output directory; the installer is written to
;                      OUT/TrinoODBC-<VERSION>-windows-x64-setup.exe
;   VERSION_NUMERIC  4-part numeric version for the version resource (default: derived from VERSION)
;   LICENSE_FILE     license text for the license page (default: STAGE/LICENSE when present;
;                    without a license file the page is skipped)
;   EXTRA_DLLS_NSH   include generated by build_installer.sh that defines the macros
;                    TRINO_INSTALL_EXTRA_DLLS / TRINO_UNINSTALL_EXTRA_DLLS for dependency DLLs staged
;                    next to trinoodbc.dll (libcurl, libstdc++, ...)
;   NO_POWERBI       build without the Power BI connector component
;   ASSETS           folder with the Trino logo branding (build_installer.sh passes
;                    packaging/assets/generated, made by packaging/assets/make_icons.sh):
;                      trinoodbc.ico          installer / uninstaller icon, Add/Remove Programs icon
;                      installer-welcome.bmp  164x314, welcome and finish pages
;                      installer-header.bmp   150x57, header of the inner pages
;                    Default: STAGE/assets, else packaging/assets/generated next to this script.
;                    Trino and the Trino logo are trademarks of the Trino Software Foundation; this
;                    driver is an independent project, not affiliated with or endorsed by it.
;
; Installer command line: /S (silent), /NODOCS, /NOPOWERBI, /D=<dir> (last argument, unquoted).
; Uninstaller: "<dir>\uninstall.exe" [/S]. Exit codes: 0 success, 1 cancelled, 2 aborted
; (unsupported system, missing rights, write error), 3010 success but a restart is needed (silent only).
;
; The registry entries are exactly those of register_driver.ps1 / installer.iss:
;   HKLM\SOFTWARE\ODBC\ODBCINST.INI\ODBC Drivers       "Trino ODBC Driver" = "Installed"
;   HKLM\SOFTWARE\ODBC\ODBCINST.INI\Trino ODBC Driver  Driver, Setup, Description, APILevel=2,
;       ConnectFunctions=YYN, DriverODBCVer=03.80, FileUsage=0, SQLLevel=1, UsageCount=1 (DWORD)
; The installer itself is a 32-bit program (NSIS only ships x86 stubs); SetRegView 64 and
; $PROGRAMFILES64 make it write the native 64-bit registry view and C:\Program Files, which is what
; 64-bit applications (Power BI Desktop, the data gateway, 64-bit Excel) and the 64-bit ODBC
; Administrator read.

Unicode true
ManifestDPIAware true
SetCompressor /SOLID lzma

!ifndef VERSION
  !error "VERSION is not defined: pass -DVERSION=<x.y.z> (packaging/windows/build_installer.sh does this)"
!endif
!ifndef STAGE
  !error "STAGE is not defined: pass -DSTAGE=<absolute path of the staging tree>"
!endif
!ifndef OUT
  !error "OUT is not defined: pass -DOUT=<absolute output directory>"
!endif
!if ! /FileExists "${STAGE}/x64/trinoodbc.dll"
  !error "${STAGE}/x64/trinoodbc.dll not found: build the Windows driver and stage it first"
!endif
!if ! /FileExists "${STAGE}/docs/*.md"
  !error "no ${STAGE}/docs/*.md found: the Documentation component needs the staged docs"
!endif
!ifndef NO_POWERBI
  !if ! /FileExists "${STAGE}/powerbi/TrinoODBC.mez"
    !error "${STAGE}/powerbi/TrinoODBC.mez not found: stage it (powerbi/build_mez.sh) or define NO_POWERBI"
  !endif
!endif

; VIProductVersion needs four numbers: "1.2.3-rc1" -> 1.2.3.0, "2.5" -> 2.5.0.0.
!ifndef VERSION_NUMERIC
  !searchparse /noerrors "${VERSION}" "" _TRINO_V1 "." _TRINO_V2 "." _TRINO_V3 "-"
  !ifndef _TRINO_V1
    !error "VERSION '${VERSION}' does not start with a number; pass -DVERSION_NUMERIC=a.b.c.d"
  !endif
  !ifndef _TRINO_V2
    !define _TRINO_V2 0
  !endif
  !ifndef _TRINO_V3
    !define _TRINO_V3 0
  !endif
  !define VERSION_NUMERIC "${_TRINO_V1}.${_TRINO_V2}.${_TRINO_V3}.0"
!endif

!ifndef LICENSE_FILE
  !if /FileExists "${STAGE}/LICENSE"
    !define LICENSE_FILE "${STAGE}/LICENSE"
  !endif
!endif

!ifndef ASSETS
  !if /FileExists "${STAGE}/assets/trinoodbc.ico"
    !define ASSETS "${STAGE}/assets"
  !else if /FileExists "${__FILEDIR__}/../assets/generated/trinoodbc.ico"
    !define ASSETS "${__FILEDIR__}/../assets/generated"
  !else
    !error "no installer branding found: pass -DASSETS=<dir with trinoodbc.ico, installer-welcome.bmp, installer-header.bmp> (packaging/assets/make_icons.sh creates them)"
  !endif
!endif
!if ! /FileExists "${ASSETS}/trinoodbc.ico"
  !error "${ASSETS}/trinoodbc.ico not found (run packaging/assets/make_icons.sh)"
!endif
!if ! /FileExists "${ASSETS}/installer-welcome.bmp"
  !error "${ASSETS}/installer-welcome.bmp not found (run packaging/assets/make_icons.sh)"
!endif
!if ! /FileExists "${ASSETS}/installer-header.bmp"
  !error "${ASSETS}/installer-header.bmp not found (run packaging/assets/make_icons.sh)"
!endif

!ifndef EXTRA_DLLS_NSH
  !warning "EXTRA_DLLS_NSH is not defined: only trinoodbc.dll is packaged from ${STAGE}/x64 (build_installer.sh adds its dependency DLLs)"
!endif

!define PRODUCT_NAME "Trino ODBC Driver"
!define DRIVER_NAME "Trino ODBC Driver"
!define DRIVER_DESCRIPTION "Trino ODBC Driver (ODBC 3.8, Unicode)"
!define PUBLISHER "Trino ODBC (open source)"
!define PRODUCT_URL "https://github.com/AhmetFurkanDEMIR/TrinoODBC"
!define ODBCINST_KEY "SOFTWARE\ODBC\ODBCINST.INI"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\TrinoODBC"
; Add/Remove Programs key of the Inno Setup installer (installer.iss AppId): both installers register
; the same ODBC driver name, so running one over the other is flagged.
!define INNO_UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\{7E1C2D8A-5B3F-4C2E-9A1D-6F0B2C3D4E5F}_is1"
!define PBI_SUBDIR "Power BI Desktop\Custom Connectors"
!define PBI_FILE "TrinoODBC.mez"
!define QUICKSTART_FILE "ODBC-DSN-QUICKSTART.txt"
; Same name as installer.iss uses, so the NSIS and the Inno Setup installer never run at the same time.
!define MUTEX_NAME "TrinoODBCSetupMutex"
!define MIN_WINDOWS_BUILD 18362
; Driver default of the TimeZone key (kDefaultSessionTimeZone in src/core/config.h).
!define DEFAULT_TIME_ZONE "Europe/Istanbul"
!define TRADEMARK_NOTE "Trino and the Trino logo are trademarks of the Trino Software Foundation. This driver is an independent project and is not affiliated with or endorsed by the Trino Software Foundation."

!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "x64.nsh"
!include "WinVer.nsh"
!include "FileFunc.nsh"
!include "Sections.nsh"

Name "${PRODUCT_NAME} ${VERSION}"
OutFile "${OUT}/TrinoODBC-${VERSION}-windows-x64-setup.exe"
InstallDir "$PROGRAMFILES64\TrinoODBC"
RequestExecutionLevel admin
BrandingText "${PRODUCT_NAME} ${VERSION} (x64)"
ShowInstDetails show
ShowUninstDetails show

; ---- helpers ------------------------------------------------------------------------------------------

; Stops the installation: logged, shown (not in silent mode) and reported as exit code 2.
!macro TRINO_FATAL MSG
  DetailPrint "Error: ${MSG}"
  MessageBox MB_ICONSTOP|MB_OK "${MSG}" /SD IDOK
  SetErrorLevel 2
  Abort "${MSG}"
!macroend

; Installs one DLL into $INSTDIR. A DLL loaded by a running process (ODBC Administrator, Power BI,
; Excel) cannot be overwritten or deleted but can be renamed, so the loaded copy is moved aside and
; deleted at the next restart while the new file takes its place immediately; that leftover alone
; does not warrant a restart prompt, so the reboot flag is restored afterwards. Only when even the
; rename fails is the new file queued to replace the old one at the next restart (restart prompted).
; Uses $R7.
!macro TRINO_INSTALL_DLL SRC NAME
  SetOverwrite try
  ClearErrors
  File "/oname=$INSTDIR\${NAME}" "${SRC}"
  ${If} ${Errors}
    DetailPrint "${NAME} is in use; moving the loaded copy aside"
    Delete "$INSTDIR\${NAME}.old"
    ClearErrors
    Rename "$INSTDIR\${NAME}" "$INSTDIR\${NAME}.old"
    ${IfNot} ${Errors}
      StrCpy $R7 "0"
      ${If} ${RebootFlag}
        StrCpy $R7 "1"
      ${EndIf}
      Delete /REBOOTOK "$INSTDIR\${NAME}.old"
      ${If} $R7 == "0"
        SetRebootFlag false
      ${EndIf}
      ClearErrors
      File "/oname=$INSTDIR\${NAME}" "${SRC}"
      ${If} ${Errors}
        !insertmacro TRINO_FATAL "Could not write $INSTDIR\${NAME}."
      ${EndIf}
    ${Else}
      ClearErrors
      File "/oname=$INSTDIR\${NAME}.new" "${SRC}"
      ${If} ${Errors}
        !insertmacro TRINO_FATAL "Could not write $INSTDIR\${NAME}.new."
      ${EndIf}
      Rename /REBOOTOK "$INSTDIR\${NAME}.new" "$INSTDIR\${NAME}"
      DetailPrint "${NAME} will be replaced when Windows restarts"
    ${EndIf}
  ${EndIf}
  SetOverwrite on
!macroend

!ifdef EXTRA_DLLS_NSH
  !include "${EXTRA_DLLS_NSH}"
!endif

; Rejects install directories under %WINDIR%: this 32-bit installer would be redirected from System32
; to SysWOW64 there, and the registered Driver path would not point to the copied file.
; Sets RESULT to "ok" or "windir"; uses $R8 and $R9, so RESULT must be another variable.
!macro TRINO_CHECK_INSTDIR RESULT
  StrLen $R9 "$WINDIR\"
  StrCpy $R8 "$INSTDIR\" $R9
  ${If} $R8 == "$WINDIR\"
    StrCpy ${RESULT} "windir"
  ${Else}
    StrCpy ${RESULT} "ok"
  ${EndIf}
!macroend

; ---- pages --------------------------------------------------------------------------------------------

!define MUI_ABORTWARNING
; Branding: the Trino logo as setup / uninstaller icon and on the wizard pages.
!define MUI_ICON "${ASSETS}/trinoodbc.ico"
!define MUI_UNICON "${ASSETS}/trinoodbc.ico"
!define MUI_WELCOMEFINISHPAGE_BITMAP "${ASSETS}/installer-welcome.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "${ASSETS}/installer-welcome.bmp"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_RIGHT
!define MUI_HEADERIMAGE_BITMAP "${ASSETS}/installer-header.bmp"
!define MUI_HEADERIMAGE_UNBITMAP "${ASSETS}/installer-header.bmp"
!define MUI_COMPONENTSPAGE_SMALLDESC
!define MUI_WELCOMEPAGE_TITLE "${PRODUCT_NAME} ${VERSION} Setup"
!define MUI_WELCOMEPAGE_TEXT "Setup installs the 64-bit Trino ODBC Driver ${VERSION} for 64-bit Windows applications such as Power BI Desktop, the on-premises data gateway and 64-bit Excel.$\r$\n$\r$\nThe driver is registered as $\"${DRIVER_NAME}$\" with the Windows ODBC Driver Manager. Close the ODBC Data Source Administrator and applications that use the driver before you continue.$\r$\n$\r$\n${TRADEMARK_NOTE}$\r$\n$\r$\n$_CLICK"
!define MUI_FINISHPAGE_TEXT "${PRODUCT_NAME} ${VERSION} has been installed.$\r$\n$\r$\nCreate a DSN in the 64-bit ODBC Data Source Administrator. Time zone: the DSN dialog pre-fills ${DEFAULT_TIME_ZONE} (UTC+3, Türkiye / Istanbul), stored as the TimeZone key; pick or type another IANA zone, or 'system' for the Windows zone."
!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_TEXT "Open the 64-bit ODBC Data Source Administrator"
!define MUI_FINISHPAGE_RUN_FUNCTION OpenOdbcAdministrator
!define MUI_FINISHPAGE_RUN_NOTCHECKED
!define MUI_FINISHPAGE_SHOWREADME "$INSTDIR\${QUICKSTART_FILE}"
!define MUI_FINISHPAGE_SHOWREADME_TEXT "Show the ODBC DSN quick start"

!insertmacro MUI_PAGE_WELCOME
!ifdef LICENSE_FILE
  !insertmacro MUI_PAGE_LICENSE "${LICENSE_FILE}"
!endif
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!define MUI_UNCONFIRMPAGE_TEXT_TOP "The ${PRODUCT_NAME} will be removed from your computer. User and system DSNs that use the driver are kept, but they stop working until the driver is installed again."
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

!insertmacro MUI_LANGUAGE "English"

VIProductVersion "${VERSION_NUMERIC}"
VIFileVersion "${VERSION_NUMERIC}"
VIAddVersionKey /LANG=${LANG_ENGLISH} "ProductName" "${PRODUCT_NAME}"
VIAddVersionKey /LANG=${LANG_ENGLISH} "CompanyName" "${PUBLISHER}"
VIAddVersionKey /LANG=${LANG_ENGLISH} "FileDescription" "${PRODUCT_NAME} ${VERSION} (x64) Setup"
VIAddVersionKey /LANG=${LANG_ENGLISH} "FileVersion" "${VERSION}"
VIAddVersionKey /LANG=${LANG_ENGLISH} "ProductVersion" "${VERSION}"
VIAddVersionKey /LANG=${LANG_ENGLISH} "LegalCopyright" "Trino ODBC contributors"
VIAddVersionKey /LANG=${LANG_ENGLISH} "LegalTrademarks" "${TRADEMARK_NOTE}"

; ---- sections -----------------------------------------------------------------------------------------

Section "Driver (required)" SEC_DRIVER
  SectionIn RO
  ; .onVerifyInstDir covers the directory page; this covers /D= in silent mode.
  !insertmacro TRINO_CHECK_INSTDIR $0
  ${If} $0 != "ok"
    !insertmacro TRINO_FATAL "The driver cannot be installed under $WINDIR ($INSTDIR). Choose another folder."
  ${EndIf}

  SetOutPath "$INSTDIR"
  ; Docs of an older version may have been renamed or removed; the Documentation component
  ; reinstalls the current set.
  Delete "$INSTDIR\docs\*.md"
  RMDir "$INSTDIR\docs"

  !insertmacro TRINO_INSTALL_DLL "${STAGE}/x64/trinoodbc.dll" "trinoodbc.dll"
  !ifdef EXTRA_DLLS_NSH
    !insertmacro TRINO_INSTALL_EXTRA_DLLS
  !endif
  !ifdef LICENSE_FILE
    File "/oname=$INSTDIR\LICENSE.txt" "${LICENSE_FILE}"
  !endif
  ; Trino logo for the Add/Remove Programs entry (DisplayIcon).
  File "/oname=$INSTDIR\trinoodbc.ico" "${ASSETS}/trinoodbc.ico"
  ; Lets an administrator repair or remove the registration without the installer.
  !if /FileExists "${__FILEDIR__}/register_driver.ps1"
    File "/oname=$INSTDIR\register_driver.ps1" "${__FILEDIR__}/register_driver.ps1"
  !endif

  ClearErrors
  FileOpen $0 "$INSTDIR\VERSION.txt" w
  ${IfNot} ${Errors}
    FileWrite $0 "${VERSION}$\r$\n"
    FileClose $0
  ${Else}
    DetailPrint "Warning: could not write $INSTDIR\VERSION.txt"
  ${EndIf}

  DetailPrint "Registering ODBC driver $\"${DRIVER_NAME}$\" -> $INSTDIR\trinoodbc.dll"
  ClearErrors
  WriteRegStr HKLM "${ODBCINST_KEY}\ODBC Drivers" "${DRIVER_NAME}" "Installed"
  WriteRegStr HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "Driver" "$INSTDIR\trinoodbc.dll"
  WriteRegStr HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "Setup" "$INSTDIR\trinoodbc.dll"
  WriteRegStr HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "Description" "${DRIVER_DESCRIPTION}"
  WriteRegStr HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "APILevel" "2"
  WriteRegStr HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "ConnectFunctions" "YYN"
  WriteRegStr HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "DriverODBCVer" "03.80"
  WriteRegStr HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "FileUsage" "0"
  WriteRegStr HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "SQLLevel" "1"
  WriteRegDWORD HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "UsageCount" 1
  ${If} ${Errors}
    !insertmacro TRINO_FATAL "Could not write the ODBC driver registration under HKLM\${ODBCINST_KEY}."
  ${EndIf}

  Call WriteQuickStart

  ClearErrors
  WriteUninstaller "$INSTDIR\uninstall.exe"
  ${If} ${Errors}
    !insertmacro TRINO_FATAL "Could not write $INSTDIR\uninstall.exe."
  ${EndIf}
SectionEnd

Section "Documentation" SEC_DOCS
  SetOutPath "$INSTDIR\docs"
  File "${STAGE}/docs/*.md"
  SetOutPath "$INSTDIR"
SectionEnd

!ifndef NO_POWERBI
Section "Power BI custom connector" SEC_POWERBI
  SetOutPath "$INSTDIR\powerbi"
  File "${STAGE}/powerbi/${PBI_FILE}"
  !if /FileExists "${STAGE}/powerbi/README.md"
    File "${STAGE}/powerbi/README.md"
  !endif
  SetOutPath "$INSTDIR"

  ; Power BI Desktop loads connectors from the Documents folder of the user who runs it. $DOCUMENTS
  ; is the folder of the user running this (elevated) setup. Service accounts (SYSTEM for Intune or
  ; SCCM deployments, LocalService, NetworkService) have their profile under %WINDIR%, which no
  ; Power BI Desktop user reads: the copy under $INSTDIR\powerbi is all they get.
  StrCpy $0 "$DOCUMENTS"
  StrLen $1 "$WINDIR\"
  StrCpy $2 "$0" $1
  ${If} $0 == ""
  ${OrIf} $2 == "$WINDIR\"
    DetailPrint "No interactive Documents folder ($0); copy $INSTDIR\powerbi\${PBI_FILE} to Documents\${PBI_SUBDIR} of each Power BI user"
  ${Else}
    StrCpy $1 "$0\${PBI_SUBDIR}"
    CreateDirectory "$1"
    SetOverwrite try
    ClearErrors
    File "/oname=$1\${PBI_FILE}" "${STAGE}/powerbi/${PBI_FILE}"
    ${If} ${Errors}
      SetOverwrite on
      DetailPrint "Warning: could not write $1\${PBI_FILE}"
      MessageBox MB_ICONEXCLAMATION|MB_OK "The Power BI connector could not be copied to$\r$\n$1$\r$\n(is Power BI Desktop running?).$\r$\n$\r$\nCopy $INSTDIR\powerbi\${PBI_FILE} there yourself." /SD IDOK
    ${Else}
      SetOverwrite on
      DetailPrint "Power BI connector: $1\${PBI_FILE}"
      ; The uninstaller may run as another user, so it removes the file recorded here.
      WriteRegStr HKLM "${UNINSTALL_KEY}" "PowerBIConnector" "$1\${PBI_FILE}"
    ${EndIf}
  ${EndIf}
SectionEnd
!endif

Section "-Add/Remove Programs entry"
  ClearErrors
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayName" "${PRODUCT_NAME} (x64)"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "Publisher" "${PUBLISHER}"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "URLInfoAbout" "${PRODUCT_URL}"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "HelpLink" "${PRODUCT_URL}/blob/main/docs/TROUBLESHOOTING.md"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
  WriteRegStr HKLM "${UNINSTALL_KEY}" "QuietUninstallString" "$\"$INSTDIR\uninstall.exe$\" /S"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\trinoodbc.ico"
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoRepair" 1
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "EstimatedSize" "$0"
  ${If} ${Errors}
    !insertmacro TRINO_FATAL "Could not write the Add/Remove Programs entry (HKLM\${UNINSTALL_KEY})."
  ${EndIf}
SectionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC_DRIVER} "trinoodbc.dll in the installation folder, registered as $\"${DRIVER_NAME}$\" with the 64-bit ODBC Driver Manager, plus an ODBC DSN quick start."
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC_DOCS} "Connection options, SSL/TLS, LDAP/AD, Power BI, types and troubleshooting guides (Markdown) in the docs folder."
  !ifndef NO_POWERBI
    !insertmacro MUI_DESCRIPTION_TEXT ${SEC_POWERBI} "TrinoODBC.mez for Power BI Desktop, copied to Documents\${PBI_SUBDIR} (a copy stays in the installation folder). Power BI must allow uncertified extensions to load it."
  !endif
!insertmacro MUI_FUNCTION_DESCRIPTION_END

; ---- installer functions ------------------------------------------------------------------------------

Function .onInit
  SetRegView 64

  ${IfNot} ${RunningX64}
    MessageBox MB_ICONSTOP|MB_OK "This installer contains the 64-bit (x64) ${PRODUCT_NAME} and needs 64-bit Windows." /SD IDOK
    SetErrorLevel 2
    Abort
  ${EndIf}
  ${If} ${IsNativeARM64}
    MessageBox MB_ICONEXCLAMATION|MB_YESNO "This is the x64 driver. On Windows on ARM only x64 applications running under emulation can load it; native ARM64 applications cannot.$\r$\n$\r$\nInstall anyway?" /SD IDYES IDYES arm64_ok
    SetErrorLevel 2
    Abort
    arm64_ok:
  ${EndIf}
  ; Same minimum as installer.iss (MinVersion=10.0.18362): the driver's IANA time zone support uses
  ; the combined System32 icu.dll that Windows ships since Windows 10 1903.
  ${IfNot} ${AtLeastBuild} ${MIN_WINDOWS_BUILD}
    MessageBox MB_ICONSTOP|MB_OK "${PRODUCT_NAME} needs Windows 10 version 1903 (build ${MIN_WINDOWS_BUILD}) or later, Windows 11 or Windows Server 2022 or later." /SD IDOK
    SetErrorLevel 2
    Abort
  ${EndIf}

  ; RequestExecutionLevel admin only asks for elevation; with UAC off a standard user gets no prompt.
  UserInfo::GetAccountType
  Pop $0
  ${If} $0 != "Admin"
    MessageBox MB_ICONSTOP|MB_OK "Administrator rights are required: ODBC drivers are registered under HKEY_LOCAL_MACHINE." /SD IDOK
    SetErrorLevel 2
    Abort
  ${EndIf}

  System::Call 'kernel32::CreateMutexW(p 0, i 0, w "${MUTEX_NAME}") p .r1 ?e'
  Pop $0
  ${If} $0 = 183 ; ERROR_ALREADY_EXISTS
    MessageBox MB_ICONSTOP|MB_OK "Another ${PRODUCT_NAME} setup is already running." /SD IDOK
    SetErrorLevel 2
    Abort
  ${EndIf}

  ${GetParameters} $R0
  ClearErrors
  ${GetOptions} $R0 "/NODOCS" $R1
  ${IfNot} ${Errors}
    !insertmacro UnselectSection ${SEC_DOCS}
  ${EndIf}
  !ifndef NO_POWERBI
    ClearErrors
    ${GetOptions} $R0 "/NOPOWERBI" $R1
    ${IfNot} ${Errors}
      !insertmacro UnselectSection ${SEC_POWERBI}
    ${EndIf}
  !endif

  ; An upgrade goes to the folder of the installed version unless /D= chose another one.
  ReadRegStr $0 HKLM "${UNINSTALL_KEY}" "InstallLocation"
  ${If} $0 != ""
  ${AndIf} $INSTDIR == "$PROGRAMFILES64\TrinoODBC"
    StrCpy $INSTDIR $0
  ${EndIf}

  ReadRegStr $0 HKLM "${INNO_UNINSTALL_KEY}" "UninstallString"
  ${If} $0 != ""
    MessageBox MB_ICONEXCLAMATION|MB_YESNO "A ${PRODUCT_NAME} installed with the Inno Setup installer was found. Both register the same ODBC driver, and uninstalling either one removes the registration.$\r$\n$\r$\nUninstall it first (Settings > Apps) to avoid two entries. Continue anyway?" /SD IDYES IDYES inno_ok
    SetErrorLevel 2
    Abort
    inno_ok:
  ${EndIf}
FunctionEnd

Function .onVerifyInstDir
  !insertmacro TRINO_CHECK_INSTDIR $0
  ${If} $0 != "ok"
    Abort
  ${EndIf}
FunctionEnd

Function .onInstSuccess
  ; Deployment tools read 3010 (ERROR_SUCCESS_REBOOT_REQUIRED) as "installed, restart pending".
  ${If} ${Silent}
  ${AndIf} ${RebootFlag}
    SetErrorLevel 3010
  ${EndIf}
FunctionEnd

Function OpenOdbcAdministrator
  ; Without this the 32-bit installer would start SysWOW64\odbcad32.exe, the 32-bit administrator,
  ; which does not list 64-bit drivers.
  ${DisableX64FSRedirection}
  Exec '"$SYSDIR\odbcad32.exe"'
  ${EnableX64FSRedirection}
FunctionEnd

; Writes $INSTDIR\ODBC-DSN-QUICKSTART.txt (UTF-16LE with BOM, so non-ASCII folder names survive).
Function WriteQuickStart
  ClearErrors
  FileOpen $0 "$INSTDIR\${QUICKSTART_FILE}" w
  ${If} ${Errors}
    DetailPrint "Warning: could not write $INSTDIR\${QUICKSTART_FILE}"
    Return
  ${EndIf}
  FileWriteUTF16LE /BOM $0 "${PRODUCT_NAME} ${VERSION} (Windows x64) - ODBC DSN quick start$\r$\n"
  FileWriteUTF16LE $0 "==========================================================$\r$\n$\r$\n"
  FileWriteUTF16LE $0 "Driver name : ${DRIVER_NAME}$\r$\n"
  FileWriteUTF16LE $0 "Driver file : $INSTDIR\trinoodbc.dll$\r$\n"
  FileWriteUTF16LE $0 "Registered  : HKLM\${ODBCINST_KEY}\${DRIVER_NAME} (64-bit view)$\r$\n$\r$\n"
  FileWriteUTF16LE $0 "1. Create a DSN in the dialog$\r$\n"
  FileWriteUTF16LE $0 "   Start the 64-bit ODBC Data Source Administrator (C:\Windows\System32\odbcad32.exe,$\r$\n"
  FileWriteUTF16LE $0 "   $\"ODBC Data Sources (64-bit)$\"). Choose System DSN (visible to services such as the Power BI$\r$\n"
  FileWriteUTF16LE $0 "   gateway) or User DSN, click Add and pick $\"${DRIVER_NAME}$\".$\r$\n$\r$\n"
  FileWriteUTF16LE $0 "2. Or create it from an elevated PowerShell$\r$\n"
  FileWriteUTF16LE $0 "   Add-OdbcDsn -Name 'Trino' -DriverName '${DRIVER_NAME}' -DsnType System -Platform 64-bit `$\r$\n"
  FileWriteUTF16LE $0 "     -SetPropertyValue @('Host=trino.example.com','Port=8443','SSL=1','SSLVerification=Full',`$\r$\n"
  FileWriteUTF16LE $0 "       'UseSystemTrustStore=1','AuthenticationType=LDAP','UID=jdoe','Catalog=hive','Schema=default')$\r$\n$\r$\n"
  FileWriteUTF16LE $0 "Connection keys$\r$\n"
  FileWriteUTF16LE $0 "   Host=trino.example.com         Trino coordinator host name$\r$\n"
  FileWriteUTF16LE $0 "   Port=8443                      HTTPS port of the coordinator (443 and 8443 are common)$\r$\n"
  FileWriteUTF16LE $0 "   SSL=1                          connect with https://$\r$\n"
  FileWriteUTF16LE $0 "   SSLVerification=Full           verify certificate chain and host name (CA = chain only, None = no checks)$\r$\n"
  FileWriteUTF16LE $0 "   UseSystemTrustStore=1          trust the CAs in the Windows certificate store, or instead:$\r$\n"
  FileWriteUTF16LE $0 "   TrustedCerts=C:\certs\corp-ca.pem   PEM bundle with the CA certificates that signed the server certificate$\r$\n"
  FileWriteUTF16LE $0 "   AuthenticationType=LDAP        user name and password (LDAP / Active Directory on the Trino side)$\r$\n"
  FileWriteUTF16LE $0 "   UID=jdoe                       user name$\r$\n"
  FileWriteUTF16LE $0 "   PWD=...                        password; better typed at connect time than stored in the DSN$\r$\n"
  FileWriteUTF16LE $0 "   Catalog=hive                   default catalog$\r$\n"
  FileWriteUTF16LE $0 "   Schema=default                 default schema$\r$\n"
  FileWriteUTF16LE $0 "   TimeZone=${DEFAULT_TIME_ZONE}       session time zone; default ${DEFAULT_TIME_ZONE} (UTC+3, Türkiye / Istanbul)$\r$\n$\r$\n"
  FileWriteUTF16LE $0 "Time zone$\r$\n"
  FileWriteUTF16LE $0 "   The driver sends the TimeZone key to Trino as the session time zone (X-Trino-Time-Zone).$\r$\n"
  FileWriteUTF16LE $0 "   Default: ${DEFAULT_TIME_ZONE} (UTC+3, Türkiye / Istanbul). The DSN dialog has a $\"Time zone$\" box$\r$\n"
  FileWriteUTF16LE $0 "   pre-filled with it and writes it to the DSN; pick or type another IANA name (UTC,$\r$\n"
  FileWriteUTF16LE $0 "   Europe/Berlin, America/New_York, ...), an offset such as +05:30, or 'system' for the Windows$\r$\n"
  FileWriteUTF16LE $0 "   time zone. In a connection string: ...;TimeZone=UTC$\r$\n$\r$\n"
  FileWriteUTF16LE $0 "DSN-less connection string$\r$\n"
  FileWriteUTF16LE $0 "   Driver={${DRIVER_NAME}};Host=trino.example.com;Port=8443;SSL=1;SSLVerification=Full;UseSystemTrustStore=1;$\r$\n"
  FileWriteUTF16LE $0 "   AuthenticationType=LDAP;UID=jdoe;PWD=secret;Catalog=hive;Schema=default$\r$\n"
  FileWriteUTF16LE $0 "   (one line; with a DSN: DSN=Trino;PWD=secret)$\r$\n$\r$\n"
  FileWriteUTF16LE $0 "Power BI Desktop$\r$\n"
  FileWriteUTF16LE $0 "   Custom connector: Documents\${PBI_SUBDIR}\${PBI_FILE} (copy in $INSTDIR\powerbi).$\r$\n"
  FileWriteUTF16LE $0 "   Enable File > Options and settings > Options > Security > Data Extensions >$\r$\n"
  FileWriteUTF16LE $0 "   $\"Allow any extension to load without validation or warning$\", restart Power BI Desktop, then$\r$\n"
  FileWriteUTF16LE $0 "   Get Data > Database > Trino (ODBC). Without the connector use Get Data > ODBC with the DSN.$\r$\n$\r$\n"
  FileWriteUTF16LE $0 "More: $INSTDIR\docs\CONNECTION-OPTIONS.md, SSL.md, LDAP-AD.md, POWERBI.md, TROUBLESHOOTING.md$\r$\n"
  FileClose $0
FunctionEnd

; ---- uninstaller --------------------------------------------------------------------------------------

; Removes one copy of the Power BI connector and the connector folders when they end up empty.
!macro TRINO_UN_REMOVE_CONNECTOR PATH
  ${If} ${FileExists} "${PATH}"
    Delete /REBOOTOK "${PATH}"
    DetailPrint "Removed ${PATH}"
  ${EndIf}
  ${un.GetParent} "${PATH}" $R1
  RMDir "$R1"
  ${un.GetParent} "$R1" $R2
  RMDir "$R2"
!macroend

Function un.onInit
  SetRegView 64
  UserInfo::GetAccountType
  Pop $0
  ${If} $0 != "Admin"
    MessageBox MB_ICONSTOP|MB_OK "Administrator rights are required to remove the ${PRODUCT_NAME}." /SD IDOK
    SetErrorLevel 2
    Abort
  ${EndIf}
FunctionEnd

Section "Uninstall"
  ; Power BI connector: the copy recorded at install time (possibly another user's Documents) and the
  ; one in the Documents folder of the user running the uninstaller.
  ReadRegStr $0 HKLM "${UNINSTALL_KEY}" "PowerBIConnector"
  ${If} $0 != ""
    !insertmacro TRINO_UN_REMOVE_CONNECTOR "$0"
  ${EndIf}
  ${If} $DOCUMENTS != ""
    StrCpy $1 "$DOCUMENTS\${PBI_SUBDIR}\${PBI_FILE}"
    ${If} $1 != $0
      !insertmacro TRINO_UN_REMOVE_CONNECTOR "$1"
    ${EndIf}
  ${EndIf}

  ; ODBC registration. A registration that points to another trinoodbc.dll (register_driver.ps1 on
  ; a development build, or a reinstall into another folder) belongs to that copy and is kept.
  ReadRegStr $0 HKLM "${ODBCINST_KEY}\${DRIVER_NAME}" "Driver"
  ${If} $0 == ""
  ${OrIf} $0 == "$INSTDIR\trinoodbc.dll"
    DeleteRegKey HKLM "${ODBCINST_KEY}\${DRIVER_NAME}"
    DeleteRegValue HKLM "${ODBCINST_KEY}\ODBC Drivers" "${DRIVER_NAME}"
    DetailPrint "Unregistered ODBC driver $\"${DRIVER_NAME}$\""
  ${Else}
    DetailPrint "Kept the ODBC registration of $\"${DRIVER_NAME}$\": it points to $0, not to $INSTDIR"
  ${EndIf}

  Delete /REBOOTOK "$INSTDIR\trinoodbc.dll"
  Delete /REBOOTOK "$INSTDIR\trinoodbc.dll.old"
  Delete /REBOOTOK "$INSTDIR\trinoodbc.dll.new"
  !ifdef EXTRA_DLLS_NSH
    !insertmacro TRINO_UNINSTALL_EXTRA_DLLS
  !endif
  Delete "$INSTDIR\VERSION.txt"
  Delete "$INSTDIR\LICENSE.txt"
  Delete "$INSTDIR\trinoodbc.ico"
  Delete "$INSTDIR\register_driver.ps1"
  Delete "$INSTDIR\${QUICKSTART_FILE}"
  Delete "$INSTDIR\docs\*.md"
  RMDir "$INSTDIR\docs"
  Delete "$INSTDIR\powerbi\${PBI_FILE}"
  Delete "$INSTDIR\powerbi\README.md"
  RMDir "$INSTDIR\powerbi"

  DeleteRegKey HKLM "${UNINSTALL_KEY}"
  Delete "$INSTDIR\uninstall.exe"
  ; Not recursive: files a user put into the folder are never deleted.
  RMDir /REBOOTOK "$INSTDIR"
  ${If} ${RebootFlag}
    DetailPrint "Files still in use are removed when Windows restarts"
  ${EndIf}
SectionEnd

Function un.onUninstSuccess
  ${If} ${Silent}
  ${AndIf} ${RebootFlag}
    SetErrorLevel 3010
  ${EndIf}
FunctionEnd
