; Export table of trinoodbc.dll.
; Exactly the entry points listed in docs/design/IMPLEMENTATION-NOTES.md ("Exported entry points"): ODBC 3.8
; ANSI + Unicode functions implemented in src/odbc/*.cpp plus the installer entry points from
; src/platform/win/setup.cpp. SQLDataSources / SQLDrivers / SQLCompleteAsync belong to the driver
; manager and are not exported. Keep in sync with src/platform/unix/exports.map / exports.macos.
LIBRARY trinoodbc
EXPORTS
    ; ---- ODBC 3.8 ANSI entry points ---------------------------------------------------------
    SQLAllocHandle
    SQLFreeHandle
    SQLAllocEnv
    SQLAllocConnect
    SQLAllocStmt
    SQLFreeEnv
    SQLFreeConnect
    SQLConnect
    SQLDriverConnect
    SQLBrowseConnect
    SQLDisconnect
    SQLEndTran
    SQLTransact
    SQLGetInfo
    SQLGetFunctions
    SQLGetTypeInfo
    SQLSetEnvAttr
    SQLGetEnvAttr
    SQLSetConnectAttr
    SQLGetConnectAttr
    SQLSetConnectOption
    SQLGetConnectOption
    SQLSetStmtAttr
    SQLGetStmtAttr
    SQLSetStmtOption
    SQLGetStmtOption
    SQLPrepare
    SQLExecute
    SQLExecDirect
    SQLNativeSql
    SQLNumParams
    SQLDescribeParam
    SQLBindParameter
    SQLSetParam
    SQLParamOptions
    SQLParamData
    SQLPutData
    SQLCancel
    SQLCancelHandle
    SQLRowCount
    SQLMoreResults
    SQLCloseCursor
    SQLFreeStmt
    SQLGetCursorName
    SQLSetCursorName
    SQLSetPos
    SQLBulkOperations
    SQLBindCol
    SQLFetch
    SQLFetchScroll
    SQLExtendedFetch
    SQLGetData
    SQLNumResultCols
    SQLDescribeCol
    SQLColAttribute
    SQLColAttributes
    SQLTables
    SQLColumns
    SQLPrimaryKeys
    SQLForeignKeys
    SQLStatistics
    SQLSpecialColumns
    SQLProcedures
    SQLProcedureColumns
    SQLTablePrivileges
    SQLColumnPrivileges
    SQLGetDiagRec
    SQLGetDiagField
    SQLError
    SQLCopyDesc
    SQLGetDescField
    SQLSetDescField
    SQLGetDescRec
    SQLSetDescRec
    SQLSetScrollOptions
    ; ---- Unicode entry points ---------------------------------------------------------------
    SQLConnectW
    SQLDriverConnectW
    SQLBrowseConnectW
    SQLGetInfoW
    SQLGetTypeInfoW
    SQLSetConnectAttrW
    SQLGetConnectAttrW
    SQLSetConnectOptionW
    SQLGetConnectOptionW
    SQLSetStmtAttrW
    SQLGetStmtAttrW
    SQLPrepareW
    SQLExecDirectW
    SQLNativeSqlW
    SQLGetCursorNameW
    SQLSetCursorNameW
    SQLDescribeColW
    SQLColAttributeW
    SQLColAttributesW
    SQLTablesW
    SQLColumnsW
    SQLPrimaryKeysW
    SQLForeignKeysW
    SQLStatisticsW
    SQLSpecialColumnsW
    SQLProceduresW
    SQLProcedureColumnsW
    SQLTablePrivilegesW
    SQLColumnPrivilegesW
    SQLGetDiagRecW
    SQLGetDiagFieldW
    SQLErrorW
    SQLGetDescFieldW
    SQLSetDescFieldW
    SQLGetDescRecW
    SQLSetDescRecW
    ; ---- ODBC installer (setup) entry points ------------------------------------------------
    ConfigDSN
    ConfigDSNW
    ConfigDriver
    ConfigDriverW
