# Helper functions for the Trino ODBC build.
include(FetchContent)

# Locate ODBC headers and the odbcinst library for the selected driver manager.
function(trino_odbc_find_driver_manager)
  set(dm "${TRINO_ODBC_DRIVER_MANAGER}")
  if(dm STREQUAL "auto")
    if(WIN32)
      set(dm windows)
    elseif(APPLE)
      set(dm iodbc)
    else()
      set(dm unixodbc)
    endif()
  endif()
  set(defines "")
  if(dm STREQUAL "windows")
    set(inc "")
    set(inst_libs odbccp32 odbc32)
    set(libs odbc32)
    list(APPEND defines TRINO_ODBC_DM_WINDOWS=1)
  elseif(dm STREQUAL "iodbc")
    # Prefer real header directories (Homebrew keg, /usr/local) over the iODBC.framework bundle, whose
    # headers directory lacks odbcinst.h.
    set(_saved_find_framework "${CMAKE_FIND_FRAMEWORK}")
    set(CMAKE_FIND_FRAMEWORK LAST)
    find_path(IODBC_INCLUDE_DIR NAMES odbcinst.h
      HINTS /opt/homebrew/opt/libiodbc/include /usr/local/opt/libiodbc/include /usr/local/include/iodbc /usr/include/iodbc /opt/homebrew/include /usr/local/include /usr/include)
    find_library(IODBC_INST_LIBRARY NAMES iodbcinst
      HINTS /opt/homebrew/opt/libiodbc/lib /usr/local/opt/libiodbc/lib /usr/local/lib /usr/lib)
    find_library(IODBC_LIBRARY NAMES iodbc
      HINTS /opt/homebrew/opt/libiodbc/lib /usr/local/opt/libiodbc/lib /usr/local/lib /usr/lib)
    if(NOT IODBC_INCLUDE_DIR OR NOT IODBC_INST_LIBRARY)
      message(FATAL_ERROR "iODBC not found (brew install libiodbc, or set TRINO_ODBC_DRIVER_MANAGER=unixodbc)")
    endif()
    set(CMAKE_FIND_FRAMEWORK "${_saved_find_framework}")
    set(inc ${IODBC_INCLUDE_DIR})
    set(inst_libs ${IODBC_INST_LIBRARY})
    set(libs ${IODBC_LIBRARY})
    list(APPEND defines TRINO_ODBC_DM_IODBC=1)
  elseif(dm STREQUAL "unixodbc")
    find_path(UNIXODBC_INCLUDE_DIR NAMES sql.h
      HINTS /opt/homebrew/opt/unixodbc/include /usr/local/opt/unixodbc/include /usr/local/include /usr/include)
    find_library(UNIXODBC_INST_LIBRARY NAMES odbcinst
      HINTS /opt/homebrew/opt/unixodbc/lib /usr/local/opt/unixodbc/lib /usr/local/lib /usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu)
    find_library(UNIXODBC_LIBRARY NAMES odbc
      HINTS /opt/homebrew/opt/unixodbc/lib /usr/local/opt/unixodbc/lib /usr/local/lib /usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu)
    if(NOT UNIXODBC_INCLUDE_DIR OR NOT UNIXODBC_INST_LIBRARY)
      message(FATAL_ERROR "unixODBC not found (apt install unixodbc-dev / brew install unixodbc)")
    endif()
    set(inc ${UNIXODBC_INCLUDE_DIR})
    set(inst_libs ${UNIXODBC_INST_LIBRARY})
    set(libs ${UNIXODBC_LIBRARY})
    list(APPEND defines TRINO_ODBC_DM_UNIXODBC=1)
  else()
    message(FATAL_ERROR "Unknown TRINO_ODBC_DRIVER_MANAGER=${dm}")
  endif()
  set(TRINO_ODBC_DM ${dm} PARENT_SCOPE)
  set(ODBC_INCLUDE_DIRS ${inc} PARENT_SCOPE)
  set(ODBC_INST_LIBRARIES ${inst_libs} PARENT_SCOPE)
  set(ODBC_LIBRARIES ${libs} PARENT_SCOPE)
  set(TRINO_ODBC_DM_DEFINES ${defines} PARENT_SCOPE)
endfunction()

# simdjson: system package (CONFIG) or FetchContent.
function(trino_odbc_find_simdjson)
  set(mode "${TRINO_ODBC_USE_SYSTEM_SIMDJSON}")
  set(found FALSE)
  if(NOT mode STREQUAL "OFF")
    find_package(simdjson CONFIG QUIET HINTS /opt/homebrew/opt/simdjson /usr/local/opt/simdjson)
    if(simdjson_FOUND)
      set(found TRUE)
      set(TRINO_ODBC_SIMDJSON_SOURCE "system" PARENT_SCOPE)
    elseif(mode STREQUAL "ON")
      message(FATAL_ERROR "System simdjson requested but not found")
    endif()
  endif()
  if(NOT found)
    set(SIMDJSON_JUST_LIBRARY ON CACHE INTERNAL "")
    set(SIMDJSON_BUILD_STATIC_LIB ON CACHE INTERNAL "")
    set(BUILD_SHARED_LIBS OFF)
    FetchContent_Declare(simdjson
      GIT_REPOSITORY https://github.com/simdjson/simdjson.git
      GIT_TAG ${TRINO_ODBC_SIMDJSON_VERSION}
      GIT_SHALLOW TRUE)
    FetchContent_MakeAvailable(simdjson)
    if(NOT TARGET simdjson::simdjson)
      add_library(simdjson::simdjson ALIAS simdjson)
    endif()
    set(TRINO_ODBC_SIMDJSON_SOURCE "fetched" PARENT_SCOPE)
  endif()
endfunction()

# Optional zstd / lz4 for the spooled protocol.
function(trino_odbc_find_optional_codecs)
  set(have_zstd FALSE)
  set(have_lz4 FALSE)
  if(NOT TRINO_ODBC_WITH_ZSTD STREQUAL "OFF")
    find_package(zstd CONFIG QUIET HINTS /opt/homebrew/opt/zstd /usr/local/opt/zstd)
    if(TARGET zstd::libzstd_shared)
      set(have_zstd TRUE)
      set(TRINO_ODBC_ZSTD_TARGET zstd::libzstd_shared PARENT_SCOPE)
    elseif(TARGET zstd::libzstd_static)
      set(have_zstd TRUE)
      set(TRINO_ODBC_ZSTD_TARGET zstd::libzstd_static PARENT_SCOPE)
    elseif(TARGET zstd::libzstd)
      set(have_zstd TRUE)
      set(TRINO_ODBC_ZSTD_TARGET zstd::libzstd PARENT_SCOPE)
    else()
      find_path(ZSTD_INCLUDE_DIR zstd.h HINTS /opt/homebrew/opt/zstd/include /usr/local/opt/zstd/include /usr/local/include /usr/include)
      find_library(ZSTD_LIBRARY NAMES zstd HINTS /opt/homebrew/opt/zstd/lib /usr/local/opt/zstd/lib /usr/local/lib /usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu)
      if(ZSTD_INCLUDE_DIR AND ZSTD_LIBRARY)
        add_library(trino_zstd INTERFACE)
        target_include_directories(trino_zstd INTERFACE ${ZSTD_INCLUDE_DIR})
        target_link_libraries(trino_zstd INTERFACE ${ZSTD_LIBRARY})
        set(have_zstd TRUE)
        set(TRINO_ODBC_ZSTD_TARGET trino_zstd PARENT_SCOPE)
      endif()
    endif()
    if(TRINO_ODBC_WITH_ZSTD STREQUAL "ON" AND NOT have_zstd)
      message(FATAL_ERROR "zstd requested but not found")
    endif()
  endif()
  if(NOT TRINO_ODBC_WITH_LZ4 STREQUAL "OFF")
    find_package(lz4 CONFIG QUIET HINTS /opt/homebrew/opt/lz4 /usr/local/opt/lz4)
    if(TARGET lz4::lz4)
      set(have_lz4 TRUE)
      set(TRINO_ODBC_LZ4_TARGET lz4::lz4 PARENT_SCOPE)
    elseif(TARGET LZ4::lz4_shared)
      set(have_lz4 TRUE)
      set(TRINO_ODBC_LZ4_TARGET LZ4::lz4_shared PARENT_SCOPE)
    elseif(TARGET LZ4::lz4_static)
      set(have_lz4 TRUE)
      set(TRINO_ODBC_LZ4_TARGET LZ4::lz4_static PARENT_SCOPE)
    else()
      find_path(LZ4_INCLUDE_DIR lz4.h HINTS /opt/homebrew/opt/lz4/include /usr/local/opt/lz4/include /usr/local/include /usr/include)
      find_library(LZ4_LIBRARY NAMES lz4 HINTS /opt/homebrew/opt/lz4/lib /usr/local/opt/lz4/lib /usr/local/lib /usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu)
      if(LZ4_INCLUDE_DIR AND LZ4_LIBRARY)
        add_library(trino_lz4 INTERFACE)
        target_include_directories(trino_lz4 INTERFACE ${LZ4_INCLUDE_DIR})
        target_link_libraries(trino_lz4 INTERFACE ${LZ4_LIBRARY})
        set(have_lz4 TRUE)
        set(TRINO_ODBC_LZ4_TARGET trino_lz4 PARENT_SCOPE)
      endif()
    endif()
    if(TRINO_ODBC_WITH_LZ4 STREQUAL "ON" AND NOT have_lz4)
      message(FATAL_ERROR "lz4 requested but not found")
    endif()
  endif()
  set(TRINO_ODBC_HAVE_ZSTD ${have_zstd} PARENT_SCOPE)
  set(TRINO_ODBC_HAVE_LZ4 ${have_lz4} PARENT_SCOPE)
endfunction()

function(trino_odbc_set_warnings target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8 /Zc:__cplusplus /EHsc /wd4100 /wd4127 /wd4996 /bigobj)
    target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS _WIN32_WINNT=0x0A00 WINVER=0x0A00 UNICODE _UNICODE)
    if(TRINO_ODBC_WERROR)
      target_compile_options(${target} PRIVATE /WX)
    endif()
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror=return-type -Wno-unused-parameter)
    if(WIN32)
      # mingw-w64 (GCC/clang targeting Windows): same Windows API level and TCHAR mapping as MSVC.
      target_compile_definitions(${target} PRIVATE _WIN32_WINNT=0x0A00 WINVER=0x0A00 UNICODE _UNICODE)
    endif()
    if(TRINO_ODBC_WERROR)
      target_compile_options(${target} PRIVATE -Werror)
    endif()
  endif()
endfunction()

# Link a static library into a shared one keeping every object (so exported SQL* symbols survive).
function(trino_odbc_whole_archive shared static)
  if(MSVC)
    target_link_options(${shared} PRIVATE "/WHOLEARCHIVE:$<TARGET_FILE_NAME:${static}>")
    add_dependencies(${shared} ${static})
  elseif(APPLE)
    target_link_options(${shared} PRIVATE "-Wl,-force_load,$<TARGET_FILE:${static}>")
  else()
    target_link_options(${shared} PRIVATE "-Wl,--whole-archive" "$<TARGET_FILE:${static}>" "-Wl,--no-whole-archive")
  endif()
endfunction()
